{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "mailflare-r2-snapshot-local",
	"main": "./worker.ts",
	"compatibility_date": "2026-10-03",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"r2_buckets": [
		{ "binding": "SOURCE", "bucket_name": "mailflare-raw", "remote": true },
		{ "binding": "BACKUP", "bucket_name": "mailflare-backups", "remote": true },
		{ "binding": "TARGET", "bucket_name": "mailflare-restore-test", "remote": false }
	],
	"vars": {
		"SOURCE_BUCKET_NAME": "mailflare-raw",
		"BACKUP_BUCKET_NAME": "mailflare-backups",
		"TARGET_BUCKET_NAME": "mailflare-restore-test"
	}
}
